# ==============================================================================
# Unity .gitignore
# Recommended rules for Unity projects (supports Unity 6, VS, Rider, UI Toolkit)
# ==============================================================================

# --- Unity Cache & Temporary Directories ---
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Uu]npack/
*.log

# --- UI Toolkit Generated Files ---
/[Uu][Ii][Ee]lements[Ss]chema/

# --- IDE & Solution / Project Files ---
.vs/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.bak
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# --- Unity3D Generated Meta Files for Ignored Items ---
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.unitypackage.meta

# --- Crash Reports & Diagnostics ---
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# --- Builds & Packages ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.ipa
*.pkg
*.dmg

# --- 3D DCC Temporary Files ---
*.blend1
*.blend1.meta

# --- JetBrains Rider Plugin ---
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- Gradle & Android Cache ---
.gradle/

# --- TestRunner Generated Files ---
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- Addressables ---
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# --- Visual Scripting Auto-generated Files ---
/[Aa]ssets/Unity.VisualScripting.Generated/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
