{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e2dc048191b74ad7bb88c75459ab571f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SobelPixelOutline (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6362.99951171875,
            "y": 1381.9998779296875,
            "width": 253.0,
            "height": 166.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "bbdc65e382d2466892b5787a7a65050b"
        },
        {
            "m_Id": "f9260574c5cc43c7903791a29ba3d20d"
        },
        {
            "m_Id": "d32774bdd28a4ed9a3e0a921a1620a93"
        },
        {
            "m_Id": "e6022689c9254bfd899f177c7ea37b92"
        },
        {
            "m_Id": "9fbffd64c5a04dd382e6ae141e4adbb4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SobelPixelOutline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 3x3 이웃 픽셀들의 오프셋 좌표 정의\r\nfloat2 uvs[3][3];\r\nfor(int sobelX = 0; sobelX < 3; sobelX++) {\r\n    for(int sobelY = 0; sobelY < 3; sobelY++) {\r\n        uvs[sobelX][sobelY] = UV + Offset * float2(sobelX - 1, sobelY - 1);\r\n    }\r\n}\r\n\r\n// 1. 깊이(Depth) 및 법선(Normal) 샘플링 공간 정의\r\nfloat d[3][3];\r\nfloat3 n[3][3];\r\n\r\n#if defined(UNIVERSAL_SHADER_VARIABLES_INCLUDED)\r\nfor(int sX = 0; sX < 3; sX++) {\r\n    for(int sY = 0; sY < 3; sY++) {\r\n        d[sX][sY] = min(LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(uvs[sX][sY]), _ZBufferParams), 200.0);\r\n        n[sX][sY] = SHADERGRAPH_SAMPLE_SCENE_NORMAL(uvs[sX][sY]);\r\n    }\r\n}\r\n#else\r\n// 셰이더 그래프 미리보기 창 등 분기 예외 처리\r\nfor(int eX = 0; eX < 3; eX++) {\r\n    for(int eY = 0; eY < 3; eY++) { \r\n        d[eX][eY] = 0.0; \r\n        n[eX][eY] = float3(0,1,0); \r\n    }\r\n}\r\n#endif\r\n\r\n// 2. 소벨 커널 가중치 적용 (가로/세로 기함수 행렬 곱)\r\nfloat d_gx = -1*d[0][0] + 1*d[2][0] - 2*d[0][1] + 2*d[2][1] - 1*d[0][2] + 1*d[2][2];\r\nfloat d_gy = -1*d[0][0] - 2*d[1][0] - 1*d[2][0] + 1*d[0][2] + 2*d[1][2] + 1*d[2][2];\r\nfloat depthEdge = sqrt(d_gx*d_gx + d_gy*d_gy);\r\n\r\nfloat3 n_gx = -1*n[0][0] + 1*n[2][0] - 2*n[0][1] + 2*n[2][1] - 1*n[0][2] + 1*n[2][2];\r\nfloat3 n_gy = -1*n[0][0] - 2*n[1][0] - 1*n[2][0] + 1*n[0][2] + 2*n[1][2] + 1*n[2][2];\r\nfloat normalEdge = sqrt(dot(n_gx, n_gx) + dot(n_gy, n_gy));\r\n\r\n// 3. 각각의 임계값(Threshold)을 통한 이진화(Step) 후 마스크 병합\r\nfloat depthAdjust = DepthThreshold * 0.8; \nfloat finalDepthEdge = step(depthAdjust, depthEdge);\nfloat finalNormalEdge = step(NormalThreshold, normalEdge);\r\n\r\n// 두 에지 중 하나라도 검출되면 윤곽선 처리\r\nEdge = max(finalDepthEdge, finalNormalEdge);"
}

