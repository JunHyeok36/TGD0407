.cmd-text {
    font-size: 32px;
    color: rgb(50, 255, 50);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

.cmd-panel {
    background-color: rgba(0, 15, 0, 0.85);
    border-width: 2px;
    border-color: rgb(50, 255, 50);
    padding: 15px;
    border-radius: 8px;
}

.mode-ui-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.deck-container {
    width: 150px;
    height: 180px;
    position: absolute;
    bottom: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 25, 20, 0.95);
    border-color: rgb(100, 120, 100);
    border-width: 4px;
    border-radius: 12px;
}

.deck-title {
    color: rgb(200, 200, 200);
    font-size: 28px;
    margin-bottom: 20px;
}

.deck-count {
    color: rgb(50, 255, 50);
    font-size: 40px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.deck-count-discard {
    color: rgb(255, 80, 80);
}

.card-container-item {
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.card-base {
    width: 300px;
    height: 450px;
    background-color: rgb(220, 220, 230);
    border-radius: 12px;
    border-width: 6px;
    border-color: rgb(60, 60, 70);
    transition-property: translate;
    transition-duration: 0.15s;
    flex-shrink: 0;
    overflow: hidden;
    margin: 0;
}

.card-empowered .card-base {
    border-color: rgb(255, 215, 0);
    border-width: 8px;
}


.card-header {
    height: 50px;
    background-color: rgb(40, 40, 50);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 15px;
    padding-right: 10px;
}

.card-name {
    font-size: 24px;
    color: white;
}

.card-cost-container {
    background-color: rgb(220, 40, 40);
    width: 36px;
    height: 36px;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    border-color: white;
}

.card-cost {
    font-size: 22px;
    color: white;
    -unity-text-align: upper-center;
}

.card-image {
    background-color: rgb(180, 180, 190);
    height: 130px;
    margin: 10px;
    border-width: 2px;
    border-color: rgb(100, 100, 110);
    justify-content: center;
    align-items: center;
}

.card-description-container {
    flex-grow: 1;
    background-color: rgb(240, 240, 245);
    margin: 0 10px 10px 10px;
    padding: 10px;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
}

.card-type {
    font-size: 18px;
    color: rgb(80, 80, 80);
    -unity-font-style: italic;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(200, 200, 200);
}

.card-desc-text {
    font-size: 16px;
    color: rgb(30, 30, 30);
    white-space: normal;
}

.hand-container {
    height: 480px;
    width: auto;
    position: absolute;
    left: 280px;
    right: 280px;
    align-items: center;
    bottom: -400px;
    transition-property: bottom;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.hand-container-active {
    bottom: -160px;
}

.hand-container-targeting {
    bottom: -520px;
}

.unity-label {
}

/* ─── 좌측 획득 토스트 알림 (TYPE A: CMD 레트로 터미널) ─── */
.acquisition-toast-container {
    position: absolute;
    left: 30px;
    top: 180px;
    width: 360px;
    pointer-events: none;
    flex-direction: column;
    align-items: flex-start;
}

.cmd-toast-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 330px;
    padding: 8px 12px;
    margin-bottom: 8px;
    background-color: rgba(0, 20, 0, 0.92);
    border-width: 2px;
    border-color: rgb(50, 255, 50);
    border-radius: 6px;
    transition-property: translate, opacity;
    transition-duration: 0.25s, 0.3s;
    transition-timing-function: ease-out;
    translate: -360px 0;
    opacity: 0;
}

.cmd-toast-item-show {
    translate: 0 0;
    opacity: 1;
}

.cmd-toast-item-hide {
    translate: -360px 0;
    opacity: 0;
}

.cmd-toast-icon-box {
    width: 42px;
    height: 42px;
    border-width: 1px;
    border-color: rgb(50, 255, 50);
    border-radius: 4px;
    background-color: rgba(0, 35, 0, 0.85);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}

.cmd-toast-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.cmd-toast-fallback-icon {
    font-size: 22px;
    color: rgb(50, 255, 50);
    -unity-text-align: middle-center;
}

.cmd-toast-content {
    flex-grow: 1;
    justify-content: center;
    overflow: hidden;
}

.cmd-toast-tag {
    font-size: 13px;
    color: rgb(80, 220, 80);
    margin-bottom: 2px;
}

.cmd-toast-name {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.cmd-toast-badge {
    background-color: rgba(0, 50, 0, 0.85);
    border-width: 1px;
    border-color: rgb(50, 255, 50);
    border-radius: 4px;
    padding: 3px 8px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.cmd-toast-badge-text {
    font-size: 16px;
    color: rgb(50, 255, 50);
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

/* ─── 플레이어 및 UI 상태효과 뱃지 ─── */
.status-badge {
    flex-direction: row;
    align-items: center;
    border-radius: 4px;
    border-width: 1px;
    padding: 2px 6px;
    background-color: rgba(30, 30, 30, 0.85);
    min-height: 22px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.status-badge-symbol {
    font-size: 16px;
    margin-right: 4px;
}

.status-badge-text {
    font-size: 14px;
    color: rgb(220, 255, 220);
    -unity-font-style: bold;
}

/* ─── 액티브 카드 가로형 와이드 HUD 바 (방안 A) ─── */
.active-wide-banner {
    position: absolute;
    left: 240px;
    right: 240px;
    bottom: 25px;
    height: 96px;
    background-color: rgba(12, 16, 24, 0.95);
    border-width: 2px;
    border-color: rgb(50, 255, 50);
    border-radius: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
    transition-property: translate, opacity, scale, background-color, border-color;
    transition-duration: 0.2s, 0.2s, 0.2s, 0.2s, 0.2s;
}

.wide-banner-left {
    flex-direction: row;
    align-items: center;
}

.wide-cost-badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(220, 40, 40);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    justify-content: center;
    align-items: center;
    margin-right: 14px;
}

.wide-cost-text {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wide-title-group {
    flex-direction: column;
    justify-content: center;
}

.wide-card-name {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-right: 8px;
}

.wide-card-type {
    font-size: 16px;
    color: rgb(160, 180, 200);
    -unity-font-style: italic;
    margin-right: 8px;
}

.wide-destroy-badge {
    font-size: 14px;
    color: rgb(240, 120, 255);
    -unity-font-style: bold;
    background-color: rgba(90, 15, 110, 0.85);
    border-width: 1px;
    border-color: rgb(230, 80, 255);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.wide-sub-tag {
    font-size: 12px;
    color: rgb(50, 255, 50);
    margin-top: 2px;
}

.wide-divider {
    width: 2px;
    height: 60px;
    background-color: rgba(80, 100, 120, 0.6);
    margin-left: 16px;
    margin-right: 16px;
}

.wide-banner-right {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.wide-card-desc {
    font-size: 16px;
    color: rgb(220, 240, 255);
    white-space: normal;
    -unity-text-align: middle-left;
}

.wide-cancel-hint {
    font-size: 12px;
    color: rgb(120, 150, 120);
    margin-top: 4px;
}

.status-badge-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}
.status-badge-text {
    font-size: 11px;
    color: rgb(235, 255, 235);
    -unity-font-style: bold;
}
